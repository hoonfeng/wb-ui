*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
.pair/

# Build output
/bin/
/dist/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Go workspace
go.work
go.work.sum

# Test coverage
coverage.txt
*.coverprofile

# Translation progress report
translation-progress.txt
# Windows reserved-name leftovers (cmd `2>nul` style redirections create these)
nul
# Generated test outputs 
*.ppm 
dump.txt 

# 示例/诊断脚本的渲染产物（examples/uitoolkit、dev/*probe）
_temp/
ui-toolkit-demo.png
 
# Consistency suite runtime reports
dev/suites/consistency/report/

# 诊断套件（dev/）的产物统一出口：探针输出的 PNG / JSON / 日志
dev/output/

# Temp debug scripts
# gen_*.py = 临时的夹具/数据生成脚本（如从浏览器抓页面数据），不纳入版本控制
gen_*.py
# Python bytecode
__pycache__/
*.pyc

# Go build cache / native assets download cache (local)
/.cache/


# 运行产物（压测基线报告、渲染截图）
/out/
/screenshots/

# 依赖与构建产物（探针/夹具的 npm 依赖）
**/node_modules/

# 探针运行产物与依赖锁文件
/dev/**/out/
/dev/output/
**/package-lock.json
**/Cargo.lock

# 探针构建产物
/dev/probes/**/dist/
/dev/probes/**/target/
*.log

# AI-PS 前端构建产物（由 web/ai-ps 源码 `npm run build` 重新生成，不入库）
web/ai-ps/dist/
# design_codegen 覆盖前的人工备份
web/ai-ps/**/*.bak

# tool-design 派生产物 / 报告（含时间戳、可由设计工程随时重新导出，不入库）
# 真相源 design.project.json / design.tokens.json 与 codegen 产物（web/ai-ps/**）仍入库
/design.html
/design.verify.json
web/ai-ps/codegen.*.json
