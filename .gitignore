Thumbs.db

# Go workspace
go.work
go.work.sum

# Test coverage
coverage.txt
*.coverprofile

# Translation progress report
translation-progress.txt
# Windows reserved-name leftovers (cmd `2>nul` style redirections create these)
nul
# Generated test outputs 
*.ppm 
dump.txt 

# 示例/诊断脚本的渲染产物（examples/uitoolkit、dev/*probe）
_temp/
# 临时验证目录（探针 / 基线对比的中间产物副本，不入库；正本见 dev/media/baseline.json）
_tmpverify/
ui-toolkit-demo.png
 
# Consistency suite runtime reports
dev/suites/consistency/report/

# 诊断套件（dev/）的产物统一出口：探针输出的 PNG / JSON / 日志
dev/output/

# Temp debug scripts
# gen_*.py = 临时的夹具/数据生成脚本（如从浏览器抓页面数据），不纳入版本控制
gen_*.py
# Python bytecode
__pycache__/
*.pyc

# Go build cache / native assets download cache (local)
/.cache/


# 运行产物（压测基线报告、渲染截图）
/out/
/screenshots/

# 依赖与构建产物（探针/夹具的 npm 依赖）
**/node_modules/

# 探针运行产物与依赖锁文件
/dev/**/out/
/dev/output/
**/package-lock.json
**/Cargo.lock

# 探针构建产物
/dev/probes/**/dist/
/dev/probes/**/target/
*.log

# AI-PS 前端构建产物（由 web/ai-ps 源码 `npm run build` 重新生成，不入库）
web/ai-ps/dist/
# design_codegen 覆盖前的人工备份
web/ai-ps/**/*.bak

# tool-design 派生产物 / 报告（含时间戳、可由设计工程随时重新导出，不入库）
# 真相源 design.project.json / design.tokens.json 与 codegen 产物（web/ai-ps/**）仍入库
/design.html
/design.verify.json
web/ai-ps/codegen.*.json

# 媒体验证（docs/media-format-verification-plan.md §6.2 / 决策 5，2026-10-07 修订）：
#   - 样本由本地脚本生成（python dev/media/gen_samples.py），**不入库**
#     （含 samples/_matrix.html：矩阵页必须与样本同级，相对路径来源才命中）；
#   - 报告、四配置静止/播放截图、逐格几何、Edge 对照图是**验收证据**（§6.3 证据纪律），
#     必须入库 —— 因此对 dev/media/out/ 开例外（上面的 /dev/**/out/ 会连报告一起忽略）。
dev/media/samples/
!dev/media/out/
!dev/media/out/**
# 生成脚本要入库（决策 5）——上面的 `gen_*.py`（临时夹具脚本）会误伤它，开例外
!dev/media/gen_samples.py
